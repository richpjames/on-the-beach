{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      // domain/ is the core: it may not reach outward. The folder is flat, so
      // any relative import leaving it starts with "../". If domain/ ever gains
      // subdirectories, loosen this to name the outward folders instead.
      "files": ["domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**"],
                "message": "domain/ is the core and must not import from outside itself."
              }
            ]
          }
        ]
      }
    },
    {
      // ports/ names the contracts the layers meet at: it is types and nothing
      // else, so it may not reach anywhere. A port that imports an adapter has
      // stopped being a port.
      "files": ["ports/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**", "**/server/**", "**/src/**"],
                "message": "ports/ declares contracts only. It may not import from server/, src/ or domain/."
              }
            ]
          }
        ]
      }
    },
    {
      // adapters/ are leaves: each one adapts one outside thing (a music
      // source, the database, the web) to the contracts in ports/ and the types
      // in domain/. They may import each other (a source that reads pages uses
      // the web adapter's fetcher), but never the app's use cases, the HTTP
      // host or the SvelteKit app — knowing about those is inverting the
      // dependency the whole layout exists to create.
      "files": ["adapters/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/server/**", "**/src/**", "**/app/**"],
                "message": "adapters/ adapt outsiders to ports/ and domain/; they must not import server/, src/ or app/."
              }
            ]
          }
        ]
      }
    },
    {
      // app/ holds the use cases: it orchestrates domain/ and adapters/ into
      // features, so it may import both — but never the HTTP host or the
      // SvelteKit app. Those are driving adapters and drive app/ from outside.
      "files": ["app/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/server/**", "**/src/**"],
                "message": "app/ is the core: it must not import the HTTP host (server/) or the SvelteKit app (src/)."
              }
            ]
          }
        ]
      }
    },
    {
      // server/ must not depend on the SvelteKit app. The reverse is correct
      // and deliberately unrestricted: route loaders driving the application
      // is what a driving adapter is for.
      "files": ["server/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/src/**"],
                "message": "server/ must not import from src/. Shared types belong in domain/."
              }
            ]
          }
        ]
      }
    },
    {
      // Browser-side code must not pull in server modules. src/routes and
      // src/hooks.server.ts are excluded: running on the server is their job.
      "files": ["src/lib/**/*.ts", "src/ui/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/server/**"],
                "message": "Client code must not import server modules. Go through src/services/api-client.ts."
              }
            ]
          }
        ]
      }
    },
    {
      // src/ui/logic/ is view-model logic: framework-free, and testable in plain
      // bun without a DOM. It imports only domain/ and itself today; these rules
      // keep it that way. The second is about direction — state/ and components/
      // drive logic/, never the reverse.
      "files": ["src/ui/logic/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["svelte", "svelte/**", "xstate", "xstate/**", "$app/**"],
                "message": "src/ui/logic/ must stay framework-free. Framework wiring belongs in src/ui/state/ or a component."
              },
              {
                "group": ["../state/**", "../components/**"],
                "message": "src/ui/logic/ is the inner ring: state/ and components/ import it, not the reverse. Shared types belong in domain/."
              }
            ]
          }
        ]
      }
    }
  ]
}
